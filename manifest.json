{
  "manifest_version": 3,
  "name": "OpenChamber Usage",
  "version": "0.6.0",
  "description": "OpenCode Go quota + per-turn cost + peak-hours timer, themed to OpenChamber.",
  "homepage_url": "https://github.com/khoale-2804/oc-usage-ext",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "scripting"],
  "host_permissions": ["https://opencode.ai/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "OpenCode Go usage"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "oc-usage-ext@khoale-2804",
      "strict_min_version": "115.0"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*"
      ],
      "js": ["shared.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
