{
  "manifest_version": 3,
  "name": "OpenChamber Go",
  "version": "0.7.0",
  "description": "DeepSeek peak-hours chip for OpenChamber, with per-subscription Go quota and a switch for the active Go key.",
  "homepage_url": "https://github.com/khoale-2804/oc-usage-ext",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "scripting"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_title": "Open OpenChamber"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "oc-go@khoale-2804",
      "strict_min_version": "115.0"
    }
  }
}
